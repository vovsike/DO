
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    token: "{{ join_token }}"
    apiServerEndpoint: "{{ control_plane_endpoint + ':6443' }}"
    caCertHashes:
      - "{{ ca_cert_hash }}"
nodeRegistration:
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ ansible_all_ipv4_addresses | select('match', '^10\.0\.0\.') | first }}"